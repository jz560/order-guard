# 仅本地开发示例值；共享环境请替换。现有数据库卷不会因修改这些值自动改密码。
POSTGRES_PASSWORD=local-admin-example-only
BACKEND_DB_PASSWORD=local-backend-example-only
SIMULATOR_DB_PASSWORD=local-simulator-example-only
POSTGRES_PORT=5432
BACKEND_PORT=8080
SIMULATOR_PORT=8081
# T05：未配置时拒绝业务访问。以下仅为本地演示示例，三类凭证不得相同。
SIMULATOR_PROFILE=demo
SIMULATOR_READ_TOKEN=local-read-example-only
SIMULATOR_EXECUTE_TOKEN=local-execute-example-only
SIMULATOR_ADMIN_TOKEN=local-admin-token-example-only
MODEL_MODE=stub
# T06 预置账号仅在 demo/test 生效；以下为本地示例。空密码禁用该账号。
BACKEND_PROFILE=demo
# Worker 仅 demo/test 生效；诊断为测试替身，T09 接续实际审批后的模拟业务执行。
WORKER_ENABLED=true
WORKER_POLL_MS=500
WORKER_LEASE_MS=30000
WORKER_STEP_DELAY_MS=1000
WORKER_RETRY_MS=1000
WORKER_MAX_FAILURES=3
DEMO_OPERATOR_PASSWORD=local-operator-example-only
DEMO_APPROVER_PASSWORD=local-approver-example-only
DEMO_OPERATOR_ORDER_PREFIX=T05-ORDER-
DEMO_APPROVER_ORDER_PREFIX=T05-ORDER-
# Java 直接启动时使用；Compose 固定使用内部服务名。
SIMULATOR_BASE_URL=http://localhost:8081
# T02 真实模型实验：仅在本机 .env 填入，默认 stub 不调用模型。
DEEPSEEK_API_KEY=

# T09 执行与查询超时，100—5000ms；执行 Worker 需要读/执行凭证同时存在。
EXECUTION_HTTP_TIMEOUT_MS=3000
