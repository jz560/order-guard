# 仅本地开发示例值；共享环境请替换。现有数据库卷不会因修改这些值自动改密码。
POSTGRES_PASSWORD=local-admin-example-only
BACKEND_DB_PASSWORD=local-backend-example-only
SIMULATOR_DB_PASSWORD=local-simulator-example-only
POSTGRES_PORT=5432
BACKEND_PORT=8080
SIMULATOR_PORT=8081
# T05：未配置时拒绝业务访问。以下仅为本地演示示例，三类凭证不得相同。
SIMULATOR_PROFILE=demo
SIMULATOR_READ_TOKEN=local-read-example-only
SIMULATOR_EXECUTE_TOKEN=local-execute-example-only
SIMULATOR_ADMIN_TOKEN=local-admin-token-example-only
MODEL_MODE=stub
# T02 真实模型实验：仅在本机 .env 填入，默认 stub 不调用模型。
DEEPSEEK_API_KEY=
